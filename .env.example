# Environment Variables Template
# Copy this file to .env and fill in the values

# Application title displayed in the UI
VITE_APP_TITLE=Ask Dreeso Memory

# Application version
VITE_APP_VERSION=1.0.0

# Simulated query latency in milliseconds (used for mock/dev mode)
VITE_MOCK_DELAY_MS=500

# Enable or disable audit logging (true | false)
VITE_ENABLE_AUDIT_LOG=false